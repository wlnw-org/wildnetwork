[Unit]
Description=wdx-agent: push wildlife detections to Wildlife Network
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/wdx-agent/wdx_agent.py --config /etc/wdx-agent.ini
Restart=always
RestartSec=30
User=__USER__

[Install]
WantedBy=multi-user.target
