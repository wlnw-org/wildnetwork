{
  "name": "wildnetwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.mts",
    "key:create": "tsx --env-file=.env.local scripts/create-key.mts",
    "pull": "tsx --env-file=.env.local scripts/pull.mts",
    "postinstall": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/ && mkdir -p public/agent && cp agent/wdx_agent.py agent/install.sh agent/wdx-agent.service public/agent/",
    "backfill": "tsx --env-file=.env.local scripts/backfill.mts",
    "backfill:weekly": "tsx --env-file=.env.local scripts/backfill-weekly.mts",
    "backfill:gbif": "tsx --env-file=.env.local scripts/backfill-gbif.mts",
    "phenology": "tsx --env-file=.env.local scripts/phenology.mts",
    "classify": "tsx --env-file=.env.local scripts/classify.mts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.87",
    "ai": "^7.0.127",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.17.1",
  "license": "AGPL-3.0-only",
  "author": "Arun Rajiah (https://www.arunrajiah.com)",
  "repository": "github:wlnw-org/wildnetwork",
  "homepage": "https://wildnetwork.arunrajiah.com"
}
