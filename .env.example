DATABASE_URL=postgres://wildnetwork:wildnetwork@localhost:5433/wildnetwork
# Optional: protects /api/cron/pull. Vercel Cron sends it automatically.
CRON_SECRET=
# Optional: Google Analytics 4 measurement id (G-XXXXXXXXXX). Visitors are asked before anything is loaded.
NEXT_PUBLIC_GA_ID=
# Optional: the Ask box (answers questions with an AI model that can only read this site's data).
# Free route, no payment card: create a key at https://aistudio.google.com/apikey and do NOT enable billing on it.
# Set these in your host's secret store (for Vercel: `vercel env add`), never in a committed file.
ASK_ENABLED=
GOOGLE_GENERATIVE_AI_API_KEY=
ASK_DAILY_LIMIT=
# Optional: xeno-canto API v3 key for the Listen block in species panels (https://xeno-canto.org/account).
# Server side only: set it with `vercel env add XENO_CANTO_API_KEY`, never in a committed file. Unset = Listen is hidden.
XENO_CANTO_API_KEY=
# Optional: species arrival alerts by email through Resend (free plan, 100 emails a day). Both unset = alerts are hidden.
# ALERTS_FROM is a sender on a domain verified in Resend, e.g. "Wildlife Network <alerts@wlnw.org>".
RESEND_API_KEY=
ALERTS_FROM=
# Alternative route through the Vercel AI Gateway (no key on Vercel, but the account needs a payment card):
AI_GATEWAY_MODEL=
AI_GATEWAY_FALLBACKS=
