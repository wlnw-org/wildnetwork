{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arunrajiah/wildlife-detection-exchange/schema/detection-event.schema.json",
  "title": "WDX Detection Event",
  "description": "A single wildlife detection event, machine-generated or (v0.3) a human observation. Wildlife Detection Exchange (WDX) v0.3 draft; v0.1 and v0.2 events remain valid.",
  "type": "object",
  "required": ["wdx", "eventId", "eventStart", "deployment", "detection", "source"],
  "properties": {
    "wdx": {
      "type": "string",
      "enum": ["0.1", "0.2", "0.3"],
      "description": "WDX spec version this event conforms to."
    },
    "eventId": {
      "type": "string",
      "minLength": 8,
      "description": "Globally unique, stable identifier for this detection event. UUIDv4 recommended."
    },
    "eventStart": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the detection window, ISO 8601 with numeric UTC offset."
    },
    "eventEnd": {
      "type": "string",
      "format": "date-time",
      "description": "End of the detection window, ISO 8601 with numeric UTC offset."
    },
    "deployment": {
      "type": "object",
      "required": ["deploymentId", "latitude", "longitude", "sensorType"],
      "properties": {
        "deploymentId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "coordinateUncertaintyMeters": { "type": "number", "exclusiveMinimum": 0 },
        "sensorType": { "type": "string", "enum": ["acoustic-recorder", "camera-trap", "other"] },
        "sensorModel": { "type": "string" }
      },
      "additionalProperties": true
    },
    "detection": {
      "type": "object",
      "if": { "required": ["observationMethod"], "properties": { "observationMethod": { "const": "human" } } },
      "then": {},
      "else": { "required": ["confidence", "classifier"] },
      "properties": {
        "observationMethod": {
          "type": "string",
          "enum": ["machine", "human"],
          "default": "machine",
          "description": "v0.3: who made the identification. A human observation has no model, so confidence and classifier are optional and MUST NOT be invented."
        },
        "individualCount": { "type": "integer", "minimum": 1, "description": "v0.3: number of individuals, as reported by the source." },
        "scientificName": { "type": "string" },
        "vernacularName": { "type": "string" },
        "taxonRank": {
          "type": "string",
          "enum": ["species", "genus", "family", "class", "unranked"],
          "default": "species"
        },
        "taxonId": {
          "type": "string",
          "pattern": "^[a-z]+:.+$",
          "description": "Checklist-prefixed identifier, e.g. gbif:2493091, ebird:comtai1, inat:13858."
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "classifier": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "classifiedAt": { "type": "string", "format": "date-time" },
        "pipeline": {
          "type": "array",
          "minItems": 1,
          "description": "v0.2: ordered model steps that led to this detection, first step first. The step that produced the label is also given as `classifier`.",
          "items": {
            "type": "object",
            "required": ["role", "name", "version"],
            "properties": {
              "role": { "type": "string", "minLength": 1, "description": "Free text. Suggested: detector, classifier, filter, tracker." },
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "weights": { "type": "string", "minLength": 1, "description": "Optional identifier of the exact weights: file hash, model registry id or URL." }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "media": {
      "type": "object",
      "required": ["mediaType"],
      "anyOf": [
        { "required": ["url"] },
        { "required": ["fileName"] }
      ],
      "properties": {
        "mediaType": { "type": "string", "enum": ["audio", "image", "video"] },
        "url": { "type": "string", "format": "uri" },
        "fileName": { "type": "string" },
        "startOffsetSeconds": { "type": "number", "minimum": 0 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "region": {
          "type": "object",
          "description": "v0.2: where the detected object is in an image or video frame. One region per event.",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "type": "string", "enum": ["box", "polygon", "point"] },
            "coordinates": {
              "type": "array",
              "description": "box: [x, y, width, height] from the top-left corner; polygon: [[x, y], ...] with at least 3 points; point: [x, y].",
              "items": { "anyOf": [{ "type": "number" }, { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }] }
            },
            "units": { "type": "string", "enum": ["normalized", "pixels"], "default": "normalized", "description": "normalized: 0 to 1 of the image width and height, origin top left." },
            "imageWidth": { "type": "integer", "exclusiveMinimum": 0 },
            "imageHeight": { "type": "integer", "exclusiveMinimum": 0 },
            "frame": { "type": "integer", "minimum": 0, "description": "Video only: frame index the region refers to. Alternatively use startOffsetSeconds." }
          },
          "allOf": [
            { "if": { "properties": { "type": { "const": "box" } } }, "then": { "properties": { "coordinates": { "minItems": 4, "maxItems": 4, "items": { "type": "number" } } } } },
            { "if": { "properties": { "type": { "const": "point" } } }, "then": { "properties": { "coordinates": { "minItems": 2, "maxItems": 2, "items": { "type": "number" } } } } },
            { "if": { "properties": { "type": { "const": "polygon" } } }, "then": { "properties": { "coordinates": { "minItems": 3, "items": { "type": "array" } } } } },
            { "if": { "properties": { "units": { "const": "pixels" } }, "required": ["units"] }, "then": { "required": ["imageWidth", "imageHeight"] } }
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["unreviewed", "confirmed", "rejected", "uncertain"] },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["system"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "systemVersion": { "type": "string" },
        "sourceRecordId": { "type": "string" },
        "provider": { "type": "string", "minLength": 1, "description": "v0.3: the contributing platform or organisation within an aggregating source, e.g. Conserve.io." },
        "trusted": { "type": "boolean", "description": "v0.3: the source's own verification or trust flag, passed through unchanged." }
      },
      "additionalProperties": true
    },
    "license": { "type": "string" }
  },
  "additionalProperties": true
}
